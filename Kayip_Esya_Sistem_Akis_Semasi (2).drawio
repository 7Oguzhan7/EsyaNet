<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Sayfa-1" id="mqt0CFEnDqhgNF9hcVhl">
    <mxGraphModel grid="1" page="1" gridSize="16" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="explanation_box_fixed" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=14;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#000000;spacingLeft=12;spacingRight=12;spacingTop=12;spacingBottom=12;lineHeight=1.6;" value="           &#10;       VERİTABANI TASARIMI VE İŞ MANTIĞI AÇIKLAMALARI&#10;&#10;1. Kullanıcı ve Yetki Yönetimi:&#10;users tablosu vatandaşları, adminleri ve kurum yetkililerini&#10;tutar. Kurum yetkilileri, institution_id üzerinden çalıştıkları&#10;şubeye (institutions tablosu) bağlanır.&#10;&#10;2. Kayıp Eşya Süreci:&#10;lost_items tablosunda kaydedilen eşyaların süreç durumları&#10;status alanından takip edilir.&#10;(Sahibi bekleniyor &gt; Açık artırmada &gt; Satıldı / Bağışlandı)&#10;&#10;3. Açık Artırma ve Teklif Mekanizması:&#10;Süresi dolan eşyalar için auctions tablosunda ihale başlatılır.&#10;Vatandaşlar bids tablosu üzerinden bu ihalelere teklif verir.&#10;&#10;4. Sanal Ödeme ve Bağış:&#10;İhaleyi kazananlar için payments tablosunda ödeme ve kargo&#10;takibi yapılır. Satılmayan eşyalar donations tablosu üzerinden&#10;ihtiyaç sahiplerine ücretsiz verilir." vertex="1">
          <mxGeometry height="500" width="500" x="656" y="-1584" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;flowchart TD\n    classDef startClass fill:#1e1b4b,stroke:#818cf8,stroke-width:2px,color:#fff;\n    classDef processClass fill:#0f172a,stroke:#3b82f6,stroke-width:2px,color:#fff;\n    classDef decisionClass fill:#311005,stroke:#ea580c,stroke-width:2px,color:#fff;\n    classDef endClass fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#fff;\n\n    Start([1. Eşya Kayıp Olarak Bulundu]) --&gt; Register[2. Kurum Eşyayı Sisteme Kaydeder]\n    Register --&gt; UserCheck{3. Sahibi Çıktı mı?}\n    \n    UserCheck -- Evet --&gt; DeliverOwner[4. Eşya Sahibine Teslim Edilir]\n    DeliverOwner --&gt; End1([Süreç Sonlandı: Sahibine Teslim])\n\n    UserCheck -- Hayır --&gt; Auction[5. Eşya Açık Artırmaya Çıkarılır]\n    Auction --&gt; BidCheck{6. Teklif Geldi mi?}\n    \n    BidCheck -- Evet --&gt; Winner[7. En Yüksek Teklif Veren Kazanır]\n    Winner --&gt; PayCheck{8. Sanal Ödeme Yapıldı mı?}\n    \n    PayCheck -- Evet --&gt; DeliverBuyer[9. Eşya Alıcıya Kargolanır &amp; Teslim Edilir]\n    DeliverBuyer --&gt; End2([Süreç Sonlandı: Satıldı])\n\n    BidCheck -- Hayır --&gt; DonationPool[11. Bağış Havuzuna Aktarılır]\n    PayCheck -- Hayır --&gt; DonationPool\n    \n    DonationPool --&gt; Request[12. İhtiyaç Sahibi Bağış Talebi Oluşturur]\n    Request --&gt; ApproveCheck{13. Kurum Talebi Onayladı mı?}\n    \n    ApproveCheck -- Evet --&gt; DeliverFree[14. Eşya Ücretsiz Teslim Edilir]\n    DeliverFree --&gt; End3([Süreç Sonlandı: Bağışlandı])\n    \n    ApproveCheck -- Hayır --&gt; DonationPool\n\n    class Start,End1,End2,End3 startClass;\n    class Register,DeliverOwner,Auction,Winner,DeliverBuyer,DonationPool,Request,DeliverFree processClass;\n    class UserCheck,BidCheck,PayCheck,ApproveCheck decisionClass;&quot;,&#10;  &quot;config&quot;: null&#10;}" id="LxTvZ1GG_GHQBs8HOsV_-1">
